diff -ruN a2/mica/mica.c b/mica/mica.c
--- a2/mica/mica.c	2026-09-14 10:35:06.577163746 +0800
+++ b/mica/mica.c	2026-09-14 10:34:40.494503333 +0800
@@ -89,11 +89,17 @@
 			return ret;
 	}
 
-	if (client->gdb_server_thread) {
-		pthread_cancel(client->gdb_server_thread);
+	/*
+	 * OH musl does not implement pthread_cancel, and this port never
+	 * spawns the gdb server thread (baremetal pedestal, no gdb stub).
+	 * When gdb support is added, enable MICA_GDB_SERVER and make the
+	 * server loop watch a stop event (pipe/eventfd) so it exits by
+	 * itself; pthread_join() then reaps it.
+	 */
+#ifdef MICA_GDB_SERVER
+	if (client->gdb_server_thread)
 		pthread_join(client->gdb_server_thread, NULL);
-	}
-		
+#endif
 
 	destory_client(client);
 	return 0;
diff -ruN a2/remoteproc/baremetal_rproc.c b/remoteproc/baremetal_rproc.c
--- a2/remoteproc/baremetal_rproc.c	2026-09-14 10:35:06.577163746 +0800
+++ b/remoteproc/baremetal_rproc.c	2026-09-14 10:34:18.451790321 +0800
@@ -13,6 +13,7 @@
 #include <syslog.h>
 #include <time.h>
 #include <string.h>
+#include <unistd.h>
 #include <metal/alloc.h>
 #include <metal/cache.h>
 #include <metal/io.h>
@@ -116,6 +117,10 @@
 
 		if (fds[0].revents & POLLIN)
 			rproc_notify_all();
+
+		/* pipe fd used to exit the wait_event */
+		if (fds[1].revents & POLLIN)
+			break;
 	}
 
 	pthread_exit(NULL);
@@ -144,7 +149,17 @@
 
 	ret = pthread_detach(thread);
 	if (ret) {
-		pthread_cancel(thread);
+		/*
+		 * OH musl does not provide pthread_cancel. detach() failed,
+		 * so the thread is still joinable: wake the poll loop through
+		 * the pipe (see rproc_wait_event) and reap it with join().
+		 */
+		char c = 1;
+
+		if (write(pipe_fd[PIPE_WRITE_END], &c, 1) < 0)
+			syslog(LOG_ERR, "unable to wake notifier thread: %s\n",
+			       strerror(errno));
+		pthread_join(thread, NULL);
 		goto err;
 	}
 
