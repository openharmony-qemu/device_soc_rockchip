import("//build/ohos.gni")

assert(target_cpu == "arm64",
       "This ispserver package supports RK3588 arm64 only.")
assert(linux_kernel_version == "linux-6.6",
       "This ispserver package requires the Linux 6.6 ISP library.")

ohos_executable("ispserver") {
  sources = [
    "ispserver.cpp",
    "mediactl.c",
  ]

  include_dirs = [
    "include",
    "include/algos",
    "include/common",
    "include/iq_parser_v2",
    "include/isp",
  ]
  defines = [ "ISP_HW_V30" ]
  cflags = [
    "-Wall",
    "-Wextra",
    "-Wno-unused-parameter",
  ]
  cflags_c = [ "-std=gnu11" ]
  cflags_cc = [ "-std=c++11" ]

  deps = [ "..:librkaiq" ]

  install_images = [ chipset_base_dir ]
  install_enable = true
  subsystem_name = "rockchip_products"
  part_name = "rockchip_products"
}
