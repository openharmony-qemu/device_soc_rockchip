import("//build/ohos.gni")
import("//build/ohos/ndk/ndk.gni")

ohos_prebuilt_shared_library("mali-g7p0-ohos") {
  if (target_cpu == "arm") {
    source = "lib/libmali-g610-ohos.so"
  } else if (target_cpu == "arm64") {
    source = "lib64/libmali-g7p0-ohos.so"
  }

  # [TODO]:decoupling system.img and vendor.img
  install_images = [ chipset_base_dir ]
  relative_install_dir = "chipsetsdk"
  #install_images = [ system_base_dir ]
  subsystem_name = "soc_rk3588"
  part_name = "soc_rk3588"
  install_enable = true
  symlink_target_name = [
    "libEGL_impl.so",
    "libGLESv1_impl.so",
    "libGLESv2_impl.so",
    "libGLESv3_impl.so",
    "libmali.so.0",
    "libmali.so.1",
  ]
}

ohos_prebuilt_etc("mali.json") {
  source = "etc/mali.json"
  module_install_dir = "etc/vulkan/icd.d"
  install_images = [ system_base_dir ]
  part_name = "soc_rk3588"
  install_enable = true
}

ohos_prebuilt_etc("firmware") {
  source = "firmware/mali_csffw.bin"
  module_install_dir = "lib/firmware/"
  install_images = [ system_base_dir ]
  subsystem_name = "soc_rk3588"
  part_name = "soc_rk3588"
  install_enable = true
}

group("gpu") {
  deps = [
    ":mali-g7p0-ohos",
    ":mali.json",
    ":firmware",
  ]
}
