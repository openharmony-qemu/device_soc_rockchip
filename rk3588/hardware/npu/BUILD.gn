#}

ohos_prebuilt_shared_library("librknnrt") {
  if (target_cpu == "arm") {
    source = "lib/librknnrt_v1.6.0_ohos_arm64.so"
  } else if (target_cpu == "arm64") {
    source = "lib64/librknnrt_v1.6.0_ohos_arm64.so"
  }

  # decoupling system.img and vendor.img
  install_images = [ chipset_base_dir ]
  subsystem_name = "rockchip_products"
  part_name = "rockchip_products"
  install_enable = true
  symlink_target_name = [
    "librknnrt.so",
    "librknnrt.so.1",
  ]
}

ohos_prebuilt_shared_library("libcxx_shared.so") {
  if (target_cpu == "arm") {
    source = "//prebuilts/clang/ohos/linux-x86_64/libcxx-ndk/lib/arm-linux-ohos/c++/libc++_shared.so"
  } else if (target_cpu == "arm64") {
    source = "//prebuilts/clang/ohos/linux-x86_64/libcxx-ndk/lib/aarch64-linux-ohos/c++/libc++_shared.so"
  }
  install_images = [ chipset_base_dir ]
  subsystem_name = "rockchip_products"
  part_name = "rockchip_products"
  install_enable = true
}

ohos_shared_library("libnpu_vdi_impl") {
  sources = [ 
    "src/nnrt_device_vdi_impl.cpp",
    "src/prepared_model_service.cpp",
  ]
  include_dirs = [
    "include",
    "${root_path}drivers/peripheral/nnrt/v2_0/include",
  ]

  deps = [ ":librknnrt", ]

  external_deps = [
    "c_utils:utils",
    "hdf_core:libhdf_ipc_adapter",
    "hdf_core:libhdf_utils",
    "hdf_core:libhdi",
    "drivers_interface_nnrt:nnrt_idl_headers",
    "drivers_interface_nnrt:libnnrt_stub_2.0",
    "hilog:libhilog",
    "ipc:ipc_single",
  ]

  install_enable = true
  install_images = [ chipset_base_dir ]
  subsystem_name = "rockchip_products"
  part_name = "rockchip_products"
}

ohos_executable("rknn_create_mem_demo") {
  sources = [ "rknn_demo/rknn_create_mem_demo.cpp" ]
  include_dirs = [ "include" ]
  deps = [ ":librknnrt" ]
  external_deps = [ "c_utils:utils" ]
  
  install_enable = true
  install_images = [ chipset_base_dir ]
  subsystem_name = "rockchip_products"
  part_name = "rockchip_products"
}

ohos_executable("rknn_yolov5_demo") {
  sources = [ 
    "rknn_demo/rknn_yolov5_demo.cc",
    "rknn_demo/postprocess/postprocess.cc",
   ]
  include_dirs = [ "include" ]
  deps = [ ":librknnrt" ]
  external_deps = [ "c_utils:utils" ]
  
  install_enable = true
  install_images = [ chipset_base_dir ]
  subsystem_name = "rockchip_products"
  part_name = "rockchip_products"
}

group("npu") {
  deps = [ 
    ":librknnrt", 
    ":libcxx_shared.so",
    ":libnpu_vdi_impl", 
    ":rknn_create_mem_demo", 
    ":rknn_yolov5_demo", 
  ]
}
