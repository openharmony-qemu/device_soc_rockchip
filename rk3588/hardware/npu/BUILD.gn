import("//build/ohos.gni")

ohos_prebuilt_shared_library("librknnrt") {
  source = "lib64/librknnrt_v2.4.1b0_ohos_arm64.so"

  # decoupling system.img and vendor.img
  install_images = [ chipset_base_dir ]
  subsystem_name = "soc_rk3588"
  part_name = "soc_rk3588"
  install_enable = true
  symlink_target_name = [
    "librknnrt.so",
    "librknnrt.so.2.4.1b0"
  ]
}

ohos_prebuilt_shared_library("libcxx_shared.so") {
  source = "//prebuilts/clang/ohos/linux-x86_64/libcxx-ndk/lib/aarch64-linux-ohos/c++/libc++_shared.so"

  install_images = [ chipset_base_dir ]
  subsystem_name = "soc_rk3588"
  part_name = "soc_rk3588"
  install_enable = true
}


ohos_shared_library("libnpu_vdi_impl_2.1") {
  sources = [ 
    "v2_1/src/nnrt_device_vdi_impl_2.1.cpp",
    "v2_1/src/prepared_model_service_2.1.cpp",
  ]
  include_dirs = [
    "./include",
    "v2_1/include",
    "../nnrt/v2_1/include",
  ]

  deps = [ ":librknnrt", ]

  external_deps = [
    "c_utils:utils",
    "hdf_core:libhdf_ipc_adapter",
    "hdf_core:libhdf_utils",
    "hdf_core:libhdi",
    "drivers_interface_nnrt:nnrt_idl_headers",
    "drivers_interface_nnrt:libnnrt_stub_2.1",
    "hilog:libhilog",
    "ipc:ipc_single",
  ]

  install_enable = true
  install_images = [ chipset_base_dir ]
  symlink_target_name = [
    "libnpu_vdi_impl.z.so"
  ]
  subsystem_name = "soc_rk3588"
  part_name = "soc_rk3588"
}

group("npu") {
  deps = [
    ":librknnrt", 
    ":libcxx_shared.so",
    ":libnpu_vdi_impl_2.1", 
  ]
}
