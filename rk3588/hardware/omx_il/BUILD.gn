  innerapi_tags = [ "passthrough_indirect" ]
  install_images = [ chipset_base_dir ]
  subsystem_name = "soc_rk3588"
  part_name = "soc_rk3588"
}

ohos_prebuilt_shared_library("libomxvpu_enc") {
  source = "lib64/libomxvpu_enc.z.so"

  innerapi_tags = [ "passthrough_indirect" ]
  install_images = [ chipset_base_dir ]
  subsystem_name = "soc_rk3588"
  part_name = "soc_rk3588"
}

ohos_prebuilt_shared_library("libOMX_Core") {
  source = "lib64/libOMX_Core.z.so"

  innerapi_tags = [ "passthrough_indirect" ]
  install_images = [ chipset_base_dir ]
  subsystem_name = "soc_rk3588"
  part_name = "soc_rk3588"
}

ohos_prebuilt_shared_library("libOMX_Pluginhw") {
  source = "lib64/libOMX_Pluginhw.z.so"

  innerapi_tags = [ "passthrough_indirect" ]
  install_images = [ chipset_base_dir ]
  subsystem_name = "soc_rk3588"
  part_name = "soc_rk3588"
}

ohos_prebuilt_shared_library("libRkOMX_Resourcemanager") {
