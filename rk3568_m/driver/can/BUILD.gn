# Real-time CAN (CAN1/CAN2) for the RK3568 AMP slave core.
#
# The Linux master (mcs_can.ko) performs all board bring-up for CAN1
# (baudclk retarget + clock hold, CRU reset pulse, can1m1 pinmux, platform
# facts published to the shared control block); this module implements the
# classic CAN 2.0B data path only, against the protocol-agnostic can.h
# contract (runtime-configurable rx mode, work mode and bit timing).
# CAN2 is a compile-time profile reserved for future expansion (verified
# path: CAN1).

import("//kernel/liteos_m/liteos.gni")

module_switch = defined(LOSCFG_MCS_CAN)
module_name = "can"

kernel_module(module_name) {
  sources = [ "can_rk3568.c" ]

  include_dirs = [
    ".",
    "//device/board/hihope/rk3568_m/liteos_m/board/include",
  ]
}

config("public") {
  include_dirs = [ "." ]
}
