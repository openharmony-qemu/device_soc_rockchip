# Copyright (c) 2026 Huawei Device Co., Ltd.
#
# Real-time NIC (GMAC1) for the RK3568 AMP slave core.
#
# The Linux master (mcs_net.ko) performs all board bring-up for GMAC1
# (clocks, reset, pinmux/GRF, PHY/MDIO, GICD routing of INTID 64 to
# CPU3); this module implements the RX/TX data path only, against the
# protocol-agnostic net.h contract (runtime-configurable mode, link
# policy and rx filter).

import("//kernel/liteos_m/liteos.gni")

module_switch = defined(LOSCFG_MCS_NET)
module_name = "net"

kernel_module(module_name) {
  sources = [ "net_dwmac.c" ]

  include_dirs = [
    ".",
    "//device/board/hihope/rk3568_m/liteos_m/board/include",
  ]
}

config("public") {
  include_dirs = [ "." ]
}
